# LK tree produced by setup.sh
/build/

# pi4-* build intermediates (each kernel7l.img itself is committed)
experiments/pi4-*/*.o
experiments/pi4-*/*.elf

# Ad-hoc hardware-debugging outputs (test images, bisection artifacts,
# serial logs) tend to get dumped straight into the repo root during
# real Pi bring-up sessions -- never intentional check-ins, and there's
# no reason to track them once the finding they were for is documented.
/*.bin
/*.elf
/*.img
/*.log
/*.folded
/nm.txt

__pycache__/
