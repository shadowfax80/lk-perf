diff --git a/lib/io/console.c b/lib/io/console.c
index f6fdb4cf..86a0a40a 100644
--- a/lib/io/console.c
+++ b/lib/io/console.c
@@ -25,6 +25,21 @@
 static spin_lock_t print_spin_lock = 0;
 static struct list_node print_callbacks = LIST_INITIAL_VALUE(print_callbacks);
 
+/* Held by a caller (see vfprintf()) across an entire formatted-print
+ * call, not just one out_count() chunk. On SMP, a single printf/dprintf
+ * call reaches out_count() multiple times (once per literal segment,
+ * once per converted argument, ...); locking only inside out_count()
+ * lets two cores' calls interleave mid-string, producing garbled
+ * console output. Confirmed on real rpi4 hardware the first time SMP
+ * was enabled for that target. */
+arch_interrupt_saved_state_t console_print_lock(void) {
+    return spin_lock_irqsave(&print_spin_lock);
+}
+
+void console_print_unlock(arch_interrupt_saved_state_t state) {
+    spin_unlock_irqrestore(&print_spin_lock, state);
+}
+
 #if CONSOLE_HAS_INPUT_BUFFER
 #ifndef CONSOLE_BUF_LEN
 #define CONSOLE_BUF_LEN 256
