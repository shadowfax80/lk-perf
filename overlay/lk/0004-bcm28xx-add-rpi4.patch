 #define SDRAM_BASE 0
 /* Note: BCM2836/BCM2837 use different peripheral base than BCM2835 */
+#if BCM2711
+#define BCM_PERIPH_BASE_PHYS    (0xFE000000U)
+#else
 #define BCM_PERIPH_BASE_PHYS    (0x3f000000U)
+#endif
 #define BCM_PERIPH_SIZE         (0x01100000U)
 
 #if BCM2836
@@ -17,6 +21,21 @@
 #elif BCM2837
 #define BCM_PERIPH_BASE_VIRT    (0xffffffffc0000000ULL)
 #define MEMORY_APERTURE_SIZE    (1024 * 1024 * 1024)
+#elif BCM2711
+/* BCM2711 (Pi 4) low-peripheral mode: main peripherals, ARM-local
+ * peripherals and the GIC-400 all live inside one 64MB physical
+ * window [0xFC000000, 0xFFFFFFFF] -- confirmed via bcm2711.dtsi, not
+ * the BCM2836/2837 layout (whose ARM-local window sits exactly
+ * 0x01000000 above the main peripheral base; BCM2711's gap is
+ * 0x01800000, so that generic derivation below does not apply and is
+ * overridden explicitly here). One mapping covers all three.
+ */
+#define BCM2711_LOW_PERIPH_PHYS (0xFC000000U)
+#define BCM2711_LOW_PERIPH_VIRT (0xe0000000U)
+#define BCM2711_LOW_PERIPH_SIZE (0x04000000U) /* 64MB */
+#define BCM_PERIPH_BASE_VIRT    (BCM2711_LOW_PERIPH_VIRT + (0xFE000000U - BCM2711_LOW_PERIPH_PHYS))
+#define BCM_LOCAL_PERIPH_BASE_VIRT (BCM2711_LOW_PERIPH_VIRT + (0xFF800000U - BCM2711_LOW_PERIPH_PHYS))
+#define BCM_GIC_BASE_VIRT       (BCM2711_LOW_PERIPH_VIRT + (0xFF840000U - BCM2711_LOW_PERIPH_PHYS))
 #else
 #error Unknown BCM28XX Variant
 #endif
@@ -25,7 +44,9 @@
 #define BCM_SDRAM_BUS_ADDR_BASE (BCM_SDRAM_BUS_ADDR_BASE_NO_L2)
 
 /* pointer to 'local' peripherals at 0x40000000 */
+#ifndef BCM_LOCAL_PERIPH_BASE_VIRT /* BCM2711 already defined this above */
 #define BCM_LOCAL_PERIPH_BASE_VIRT (BCM_PERIPH_BASE_VIRT + 0x01000000)
+#endif
 
 #define IC0_BASE                (BCM_PERIPH_BASE_VIRT + 0x2000)
 #define ST_BASE                 (BCM_PERIPH_BASE_VIRT + 0x3000)
@@ -62,6 +83,9 @@
 #define ARM0_MAILBOX_STATUS     (ARM0_MAILBOX_BASE + 0x18)
 #define ARM0_MAILBOX_WRITE      (ARM0_MAILBOX_BASE + 0x20)
 
+#ifndef BCM_LOCAL_PERIPH_BASE_VIRT
+#define BCM_LOCAL_PERIPH_BASE_VIRT (BCM_PERIPH_BASE_VIRT + 0x01000000)
+#endif
 #define ARM_LOCAL_BASE          (BCM_LOCAL_PERIPH_BASE_VIRT)
 
 /* interrupts */
@@ -171,7 +195,26 @@
 #define INTERRUPT_ARM_LOCAL_ZERO       (ARM_IRQ_LOCAL_BASE + 10)
 #define INTERRUPT_ARM_LOCAL_TIMER      (ARM_IRQ_LOCAL_BASE + 11)
 
+#if BCM2711
+/* Using dev/interrupt/arm_gic instead of this file's own vector
+ * numbering (see below) -- GIC SPI IDs go well past 107
+ * (INTERRUPT_ARM_LOCAL_TIMER), e.g. UART0 is GIC ID 153. */
+#undef MAX_INT
+#define MAX_INT 256
+/* Redefine the two vector-number macros uart.c and platform.c already
+ * use (INTERRUPT_VC_UART, INTERRUPT_ARM_LOCAL_CNTPNSIRQ) to the real
+ * GIC IDs for BCM2711, confirmed against bcm2711.dtsi: non-secure
+ * physical timer = PPI 14 = GIC ID 30, PL011 UART0 = SPI 121 = GIC ID
+ * 153. This is what makes uart.c reusable unmodified: it already
+ * calls register_int_handler(INTERRUPT_VC_UART + i, ...); redefining
+ * the macro is enough, no source edit needed. */
+#undef INTERRUPT_VC_UART
+#define INTERRUPT_VC_UART 153
+#undef INTERRUPT_ARM_LOCAL_CNTPNSIRQ
+#define INTERRUPT_ARM_LOCAL_CNTPNSIRQ 30
+#else
 #define MAX_INT INTERRUPT_ARM_LOCAL_TIMER
+#endif
 
