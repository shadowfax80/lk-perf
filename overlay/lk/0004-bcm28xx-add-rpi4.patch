+++ b/platform/bcm28xx/include/platform/gic.h
@@ -0,0 +1,10 @@
+/*
+ * dev/interrupt/arm_gic/arm_gic.c unconditionally includes
+ * <platform/gic.h> -- every platform using that module must supply
+ * one, even a thin stub (see platform/qemu-virt-arm/include/platform/gic.h
+ * for the same pattern). Only MAX_INT is actually needed here, and
+ * platform/bcm28xx.h already defines it correctly per variant.
+ */
+#pragma once
+
+#include <platform/bcm28xx.h>
