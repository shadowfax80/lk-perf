+/* lk-perf K12: optional masking by GIC priority ("pseudo-NMI").
+ *
+ * In this mode, thread-context masking raises the GIC CPU interface
+ * priority mask (GICC_PMR) instead of setting CPSR.I. Interrupts at
+ * normal priority stay blocked, so LK's critical sections keep their
+ * meaning, but higher-priority interrupts -- the PMU sampling SPIs --
+ * still arrive inside masked code and sample its real PC. Exception
+ * entry still sets CPSR.I, so interrupt handlers themselves stay
+ * unsampled. Off by default and switched per core from an IPI, which is
+ * only taken while that core is unmasked.
+ *
+ * Every read or change of a core's PMR state runs with CPSR.I set, so a
+ * thread cannot migrate between reading its core number and using that
+ * core's state. The IRQ exception path saves the interrupted context's
+ * state on the thread's own stack and restores it before returning
+ * (arm_nmi_irq_enter/exit), as the hardware does for CPSR.I. A normal
+ * interrupt racing with the PMR write reads as spurious at the GIC and
+ * stays pending. Interrupt handlers that may run in masked code (the PMU
+ * sampler) must not reschedule, take locks or print. */
+#define ARM_NMI_PMR_MASKED 0x80u /* Non-secure view; blocks normal priority */
+#define ARM_NMI_PMR_OPEN 0xffu
+extern volatile uint32_t *arm_nmi_pmr;
+extern volatile uint32_t arm_nmi_any;
+extern volatile uint32_t arm_nmi_mode[];
+extern volatile uint32_t arm_nmi_masked[];
+uint32_t arm_nmi_irq_enter(void);
+void arm_nmi_irq_exit(uint32_t saved);
+
+static inline uint32_t arm_nmi_cpu(void) {
+#if WITH_SMP
+    uint32_t mpidr;
+    __asm__ volatile("mrc p15, 0, %0, c0, c0, 5" : "=r"(mpidr));
+    return ((mpidr & ((1U << SMP_CPU_ID_BITS) - 1)) >> 8 << SMP_CPU_CLUSTER_SHIFT) |
+           (mpidr & 0xff);
+#else
+    return 0;
+#endif
+}
