+// K12: IRQ entry, CPSR.I set. Returns whether the interrupted code was
+// masked by priority; the exception path keeps it on the thread's stack.
+uint32_t arm_nmi_irq_enter(void) {
+    return arm_nmi_masked[arch_curr_cpu_num()];
+}
+
+// K12: IRQ exit, just before the exception return (replaces the direct
+// arm_irqmask_irq_exit call). Restores the interrupted context's priority
+// mask on the core it now returns on, and closes accounting regions: all
+// of them when that context was unmasked, only the handler's own when it
+// was masked by priority (a pseudo-NMI inside a masked region).
+void arm_nmi_irq_exit(uint32_t saved) {
+    uint cpu = arch_curr_cpu_num();
+    if (arm_irqmask_on) {
+        struct arm_irqmask_cpu *c = &arm_irqmask_cpu[cpu];
+        if (c->active && (!saved || c->site >= ARM_IRQMASK_IRQ_SITE))
+            irqmask_close(c);
+    }
+    if (saved && !arm_nmi_masked[cpu]) {
+        arm_nmi_masked[cpu] = 1;
+        *arm_nmi_pmr = ARM_NMI_PMR_MASKED;
+    } else if (!saved && arm_nmi_masked[cpu]) {
+        arm_nmi_masked[cpu] = 0;
+        *arm_nmi_pmr = ARM_NMI_PMR_OPEN;
+    }
+}
