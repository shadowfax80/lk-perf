 void uart_flush_tx(int port) {
+    uintptr_t base = uart_to_ptr(port);
+
+    /* spin until the fifo is empty (TXFE) and the last byte has left the shifter (!BUSY) */
+    while (!(UARTREG(base, UART_TFR) & (1<<7)) || (UARTREG(base, UART_TFR) & (1<<3)))
+        ;
 }
 
