diff --git a/platform/bcm28xx/platform.c b/platform/bcm28xx/platform.c
index 0149694..92a006d 100644
--- a/platform/bcm28xx/platform.c
+++ b/platform/bcm28xx/platform.c
@@ -419,3 +419,38 @@ int platform_dgetc(char *c, bool wait) {
     return 0;
 }
 
+/* PM block watchdog: the only software-reachable full-SoC reset on these
+ * parts (same sequence as Linux's bcm2835_wdt restart handler). */
+#define PM_RSTC                     (PM_BASE + 0x1c)
+#define PM_RSTS                     (PM_BASE + 0x20)
+#define PM_WDOG                     (PM_BASE + 0x24)
+#define PM_PASSWORD                 (0x5a000000u)
+#define PM_RSTC_WRCFG_MASK          (0x00000030u)
+#define PM_RSTC_WRCFG_FULL_RESET    (0x00000020u)
+/* partition 63, spread over the even RSTS bits: the firmware's "halt, don't boot" marker */
+#define PM_RSTS_PARTITION_HALT      (0x00000555u)
+
+static void bcm28xx_watchdog_reset(void) {
+    arch_disable_ints();
+    uart_flush_tx(DEBUG_UART);
+
+    /* 65536 ticks/s, so 10 ticks is ~150us: enough to finish the RSTC write below */
+    *REG32(PM_WDOG) = PM_PASSWORD | 10;
+    uint32_t rstc = *REG32(PM_RSTC) & ~(PM_RSTC_WRCFG_MASK | 0xff000000u);
+    *REG32(PM_RSTC) = PM_PASSWORD | rstc | PM_RSTC_WRCFG_FULL_RESET;
+
+    for (;;)
+        arch_idle();
+}
+
+static void bcm28xx_poweroff(void) {
+    uint32_t rsts = *REG32(PM_RSTS) & ~0xff000000u;
+    *REG32(PM_RSTS) = PM_PASSWORD | rsts | PM_RSTS_PARTITION_HALT;
+    bcm28xx_watchdog_reset();
+}
+
+void platform_halt(platform_halt_action suggested_action,
+                   platform_halt_reason reason) {
+    platform_halt_default(suggested_action, reason,
+                          bcm28xx_watchdog_reset, bcm28xx_poweroff);
+}
