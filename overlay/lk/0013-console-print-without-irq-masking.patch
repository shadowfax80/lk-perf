 /* routines for dealing with main console io */
@@ -32,12 +33,39 @@
  * lets two cores' calls interleave mid-string, producing garbled
  * console output. Confirmed on real rpi4 hardware the first time SMP
  * was enabled for that target. */
-arch_interrupt_saved_state_t console_print_lock(void) {
-    return spin_lock_irqsave(&print_spin_lock);
+/* lk-perf K6: a print holds this lock while the UART sends the whole
+ * line (about 170 us per 100 characters at 6 Mbaud), so masking IRQs
+ * for it hid that time from IRQ sampling and delayed every interrupt
+ * behind it. Ordinary thread-context prints now serialise on a mutex
+ * instead, with IRQs left enabled. Prints that cannot block -- from an
+ * IRQ handler, with IRQs already masked, or from an idle thread -- keep
+ * the IRQ-masking spinlock; such a print can interleave with a
+ * thread-context line, which is rare and only cosmetic. */
+static mutex_t print_mutex = MUTEX_INITIAL_VALUE(print_mutex);
+
+static bool console_print_can_block(void) {
+    if (arch_ints_disabled() || arch_in_int_handler())
+        return false;
+    thread_t *t = get_current_thread();
+    return t && !(t->flags & THREAD_FLAG_IDLE);
 }
 
-void console_print_unlock(arch_interrupt_saved_state_t state) {
-    spin_unlock_irqrestore(&print_spin_lock, state);
+console_print_state_t console_print_lock(void) {
+    console_print_state_t state = { .mutex = false };
+    if (console_print_can_block()) {
+        mutex_acquire(&print_mutex);
+        state.mutex = true;
+    } else {
+        state.irq = spin_lock_irqsave(&print_spin_lock);
+    }
+    return state;
+}
+
+void console_print_unlock(console_print_state_t state) {
+    if (state.mutex)
+        mutex_release(&print_mutex);
+    else
+        spin_unlock_irqrestore(&print_spin_lock, state.irq);
 }
 
